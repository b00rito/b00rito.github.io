---
layout: compress
permalink: /feed.xml
# Atom feed. Local override of the Chirpy gem's assets/feed.xml. The only
# functional change from the gem template is the <?xml?> / <?xml-stylesheet?>
# prolog, which points browsers at assets/feed.xsl so the feed renders as a
# readable page instead of raw XML. Feed readers ignore the stylesheet.
#
# The prolog is emitted OUTSIDE the {% capture %} and with whitespace-control
# tags so that <?xml ...?> is the very first byte in both `serve` (dev) and
# CI (production) builds -- production strips leading whitespace via
# compress_html, development does not.
#
# On a Chirpy upgrade, re-diff the captured <feed> block against
#   vendor/bundle/ruby/*/gems/jekyll-theme-chirpy-*/assets/feed.xml
# reference: https://validator.w3.org/feed/docs/atom.html
---
{%- capture source -%}
<feed xmlns="http://www.w3.org/2005/Atom">
  <id>{{ "/" | absolute_url }}</id>
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.social.name }}</name>
    <uri>{{ "/" | absolute_url }}</uri>
  </author>
  <link rel="self" type="application/atom+xml" href="{{ page.url | absolute_url }}"/>
  <link rel="alternate" type="text/html" hreflang="{{ site.alt_lang | default: site.lang }}"
    href="{{ '/' | absolute_url }}"/>
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <rights> (c) {{ 'now' | date: '%Y' }} {{ site.social.name }} </rights>
  <icon>{{ site.baseurl }}/assets/img/favicons/favicon.ico</icon>
  <logo>{{ site.baseurl }}/assets/img/favicons/favicon-96x96.png</logo>

{% for post in site.posts limit: 5 %}
  {% assign post_absolute_url = post.url | absolute_url %}
  <entry>
    <title>{{ post.title }}</title>
    <link href="{{ post_absolute_url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}" />
    <published>{{ post.date | date_to_xmlschema }}</published>
  {% if post.last_modified_at %}
    <updated>{{ post.last_modified_at | date_to_xmlschema }}</updated>
  {% else %}
    <updated>{{ post.date | date_to_xmlschema }}</updated>
  {% endif %}
    <id>{{ post_absolute_url }}</id>
    <content type="text/html" src="{{ post_absolute_url }}" />
    <author>
      <name>{{ post.author | default: site.social.name }}</name>
    </author>

  {% if post.categories %}
    {% for category in post.categories %}
    <category term="{{ category }}" />
    {% endfor %}
  {% endif %}

  <summary>{% include post-summary.html max_length=400 %}</summary>

  </entry>
{% endfor %}
</feed>
{%- endcapture -%}
<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/xsl" href="{{ '/assets/feed.xsl' | relative_url }}"?>
{{ source | replace: '&', '&amp;' }}
